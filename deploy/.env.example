# Configuração do Trackify em produção (qualquer VPS). Copie para deploy/.env e preencha.
# Segredos: gere cada um com `openssl rand -hex 32`. Nunca reaproveite os de teste.

# Como o painel chega à internet (um só): cloudflare, caddy ou vazio (proxy próprio). Veja docs/hospedagem.md.
COMPOSE_PROFILES=cloudflare
# Só com cloudflare: o token do túnel (Zero Trust, Networks, Tunnels).
TUNNEL_TOKEN=
# Só com caddy: o domínio do painel, já apontando (registro A) para o IP da VPS.
DOMAIN=

POSTGRES_PASSWORD=
# Primeiro admin: senha com 12 caracteres ou mais (openssl rand -base64 18).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Endereço público do painel, sem barra no fim.
PUBLIC_URL=https://app.seudominio.com.br
CRON_SECRET=
DEFAULT_TIMEZONE=America/Sao_Paulo
META_API_VERSION=v23.0

# Borda (opcional): Worker da Cloudflare ou outro serviço de borda que repasse com o mesmo segredo. Sem borda, deixe vazio:
# o script é servido pelo próprio painel (sem cookie de 400 dias).
EDGE_SECRET=
EDGE_URL=

# Domínio do cliente na borda (Cloudflare for SaaS). Token com permissão SSL and Certificates:Edit na zona; CF_SAAS_TARGET é o hostname de origem (fallback origin) para onde o cliente aponta o CNAME.
CF_API_TOKEN=
CF_ZONE_ID=
CF_SAAS_TARGET=

# Chave dos dados pessoais do CRM (AES-256-GCM). Gere com: openssl rand -hex 32. Guarde fora do servidor: sem ela os contatos ficam ilegíveis.
DATA_KEY=

# Backup (deploy/backup.sh): remoto do rclone, de preferência cifrado. Qualquer S3: Cloudflare R2, Backblaze B2, AWS S3, Wasabi...
BACKUP_REMOTE=r2crypt:

# Opcional: sugestão de coluna do CRM por IA nas conversas do WhatsApp (texto anonimizado). Sem chave, valem as regras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
