# Primeiro admin. Só é usado quando o banco ainda não tem nenhum usuário. Senha com 12 caracteres ou mais (openssl rand -base64 18).
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=

# Endereço público do painel (sem barra no final). Usado no snippet, nas URLs de webhook e nos links de convite.
PUBLIC_URL=https://stats.exemplo.com

# Banco: PostgreSQL. Vazio = Postgres local do Docker (postgres://rastro:rastro@127.0.0.1:55432/rastro).
DATABASE_URL=

# Segredo da rota /cron (sync da Meta de hora em hora). Gere com: openssl rand -hex 32
CRON_SECRET=

# 1 = pega o IP do cliente de X-Forwarded-For (túnel da Cloudflare ou proxy reverso)
TRUST_PROXY=1

# Fuso padrão para novos sites
DEFAULT_TIMEZONE=America/Sao_Paulo

# Só para o servidor local (npm start)
HOST=127.0.0.1
PORT=8080

# off = sem tela de login, entra como o dono (ferramenta interna). Só vale com HOST=127.0.0.1.
LOGIN=

# Versão da Graph API da Meta (sync de anúncios e Conversions API)
META_API_VERSION=v23.0

# Segredo compartilhado com o Worker da borda (edge/wrangler.toml). Gere com: openssl rand -hex 32
EDGE_SECRET=

# Endereço do Worker da borda (ex.: https://t.seudominio.com.br), mostrado no snippet da tela Integrações
EDGE_URL=

# Domínio do cliente na borda (Cloudflare for SaaS). Token com SSL and Certificates:Edit e Workers Routes:Edit na zona (o Trackify cria a rota do Worker por domínio de cliente); CF_SAAS_TARGET é o hostname de origem (fallback origin) para onde o cliente aponta o CNAME.
CF_API_TOKEN=
CF_ZONE_ID=
CF_SAAS_TARGET=
# Nome do Worker da borda, se não for "trackify"
CF_WORKER=

# Chave dos dados pessoais do CRM (AES-256-GCM). Gere com: openssl rand -hex 32. Guarde fora do servidor: sem ela os contatos ficam ilegíveis.
DATA_KEY=

# Opcional: sugestão de coluna do CRM por IA nas conversas do WhatsApp (texto anonimizado). Sem chave, valem as regras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
